<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="fileExtensions" value="java, properties, xml"/>

    <!-- Límite de 100 caracteres por línea (estándar de Google) -->
    <module name="LineLength">
        <property name="fileExtensions" value="java"/>
        <property name="max" value="100"/>
        <property name="ignorePattern" value="^package.*|^import.*|a href|href|http://|https://|ftp://"/>
    </module>

    <module name="TreeWalker">
        <!-- Reglas de Nombres (Naming Conventions) -->
        <module name="LocalVariableName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>
        <module name="MemberName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>
        <module name="MethodName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>
        <module name="TypeName">
            <property name="format" value="^[A-Z][a-zA-Z0-9]*$"/>
        </module>
        <module name="ConstantName">
            <property name="format" value="^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$"/>
        </module>

        <!-- Limpieza de Imports -->
        <module name="AvoidStarImport"/> <!-- Prohíbe usar import java.util.*; -->
        <module name="UnusedImports"/>   <!-- Falla si hay un import que no se usa -->

        <!-- Reglas de Llaves (Braces) -->
        <module name="NeedBraces"/>      <!-- Obliga a usar {} en todos los if/else/for -->
        <module name="LeftCurly"/>       <!-- La llave { debe ir en la misma línea -->
        <module name="RightCurly"/>      <!-- La llave } debe ir en su propia línea -->

        <!-- Evitar código redundante -->
        <module name="ModifierOrder"/>   <!-- public static final (en ese orden) -->
        <module name="EmptyBlock"/>      <!-- Falla si hay un if {} o catch {} vacío -->
    </module>
</module>